{
  "profiles": {
    "defaults": {
      "font": { "face": "Maple Mono NF CN", "size": 13 },
      "background": "#282C34"
    }
  },
  "actions": [
    {
      "id": "AgentTheme.Newline",
      "command": { "action": "sendInput", "input": "\u001b\r" }
    },
    {
      "id": "AgentTheme.PasteClipboard",
      "command": { "action": "sendInput", "input": "\u0016" }
    }
  ],
  "keybindings": [
    { "id": "AgentTheme.Newline", "keys": "shift+enter" },
    { "id": "AgentTheme.PasteClipboard", "keys": "ctrl+v" }
  ]
}
